# Kopiera till .env och fyll i. Se README för instruktioner.

# --- Databas ---
DATABASE_URL="file:./data/utlagg.db"

# --- Auth.js ---
# Generera med: openssl rand -base64 32
AUTH_SECRET=""
# Full adress till appen, t.ex. https://utlagg.mtek.chalmers.se (lokalt: http://localhost:3000)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Kommaseparerad lista över adminkonton (kassören)
ADMIN_EMAILS="ekonomi@mtek.chalmers.se"

# --- Kryptering av kontonummer ---
# Generera med: openssl rand -hex 32   (64 hex-tecken)
ENCRYPTION_KEY=""

# --- Filer ---
UPLOAD_DIR="./data/uploads"
PDF_DIR="./data/pdf"

# --- E-post ---
# Mailen skickas i första hand via Googles mail-API med samma inloggning som Drive
# (GOOGLE_REFRESH_TOKEN nedan). Det krävs på plattformar som blockerar utgående SMTP,
# vilket Railway och de flesta molntjänster gör. Kräver att Gmail API är påslaget i
# Google Cloud-projektet.
#
# SMTP används bara om Gmail-API:t inte är konfigurerat, t.ex. på en egen server.
# Lämna tomt annars; utan bådadera sparas mailen som filer i ./data/outbox.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Tvinga ett visst sätt: gmail, smtp eller outbox. Tomt = välj automatiskt.
MAIL_TRANSPORT=""

MAIL_FROM="Maskinteknologsektionen <ekonomi@mtek.chalmers.se>"
# Adress som får notis om utlägg utan egen kommittékassör
MAIL_ADMIN="ekonomi@mtek.chalmers.se"
# Frivillig kopia av godkända blanketter (arkiv)
MAIL_ARCHIVE=""

# --- Google Drive ---
# Skaffas med: npm run drive:auth  (loggar in som ekonomi@mtek.chalmers.se).
# Samma nyckel används både för att spara blanketter i Drive och för att skicka mail.
GOOGLE_REFRESH_TOKEN=""
# ID på mappen i Drive där blanketter sparas (sista delen av mappens URL)
GOOGLE_DRIVE_FOLDER_ID=""

# --- Automatik (frivilligt, standardvärden visas) ---
# Dagar innan kassören påminns om utlägg som väntar på beslut eller utbetalning
REMINDER_DAYS="7"
# Dagar efter utbetalning/nekande som kontonumret behålls i databasen (GDPR-gallring)
ACCOUNT_RETENTION_DAYS="90"
# Dagar ett orört utkast behålls
DRAFT_RETENTION_DAYS="60"
# Hemlighet för POST /api/jobs om en extern schemaläggare ska köra jobben (annars sköts det internt)
JOBS_SECRET=""
# Sätt till 1 för att stänga av den interna schemaläggaren
DISABLE_SCHEDULER=""

# --- Behörighet ---
# Kommaseparerade e-postdomäner som får logga in. Tomt = alla Google-konton.
# Underdomäner räknas med, så "chalmers.se" släpper även in student.chalmers.se.
ALLOWED_EMAIL_DOMAINS="chalmers.se,mtek.chalmers.se"

# Botkontot som alla utskick kommer från (utlagg@). Hämtas med: npm run mail:auth
# Lämnas det tomt skickas mailen med samma konto som Drive (ekonomi@).
MAIL_GOOGLE_REFRESH_TOKEN=""
